<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <style name="AlarmTheme" parent="AppTheme">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/bg_deep</item>
    </style>

    <style name="AppDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/bg_deep</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogButtonPositive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppDialogButtonNegative</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AppDialogButtonNeutral</item>
    </style>

    <style name="AppDialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppDialogButtonPositive" parent="AppDialogButton">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="AppDialogButtonNegative" parent="AppDialogButton">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="AppDialogButtonNeutral" parent="AppDialogButton">
        <item name="android:textColor">@color/amber</item>
    </style>
</resources>
